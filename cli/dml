              out+="{\"key\":\"$key\",\"group\":\"$group\",\"label\":\"$je_label\",\"explain\":\"$je_explain\",\"type\":\"$type\",\"min\":$minj,\"max\":$maxj,\"value\":\"\",\"default\":\"$je_def\",\"restart_required\":$rreq,\"env\":\"$env\"}"
