              [[ $first -eq 0 ]] && cpp+=','
              cpp+="{\"key\":\"$mk\",\"name\":\"$je_name\",\"desc\":\"$je_desc\",\"url\":$je_url,\"installed\":false,\"pending_rebuild\":false,\"conf\":\"\",\"conf_name\":$cnamej,\"custom\":false,\"head\":null,\"head_date\":null}"
