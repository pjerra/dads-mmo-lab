            trap '_flush_restore_flag' EXIT
            for _fsig in HUP INT TERM PIPE; do
              # shellcheck disable=SC2064 -- $_fsig must expand at trap time
              trap "_flush_restore_flag_signal $_fsig" "$_fsig"
            done
