# GENERATED by dml — do not hand-edit; `install-native` rewrites this file.
#
# The native (Docker Desktop on Windows) AzerothCore + playerbots stack.
# Modelled on the WORKING migrated server, which is proof rather than a guess.
#
# THREE FILES, and the split is the point:
#   * docker-compose.yml       (this file) services, ports, image tags, binds.
#   * docker-compose.override.yml   runtime env + the ./modules mount. Compose
#     auto-loads it; the dml config system READS AND WRITES it and its YAML
#     writer drops comments — which is exactly why nothing structural lives
#     there.
#   * docker-compose.build.yml      the build:/target: keys, passed explicitly
#     with -f during the install/build stage ONLY, so a post-install `up`
#     never rebuilds and the config writer never touches build config.
#
# CONTAINER NAMES ARE A CONTRACT. `wow backup` runs `docker exec ac-database
# mysqldump`, world-restart runs `docker restart -t 300 ac-worldserver`, the
# boot log snapshot resolves ac-worldserver through this compose project, and
# `config`'s frozen-env check inspects ac-worldserver by name. Renaming a
# container here silently breaks all of them.
name: {{PROJECT_NAME}}

services:
  ac-database:
    container_name: ac-database
    image: mysql:8.4
    networks: [ac-network]
    ports:
      # Loopback-ONLY on purpose: the launcher's native reader opens a direct
      # connection to 127.0.0.1 (crates/dml-wow/src/db.rs) and nothing off this
      # box has any business reaching MySQL. The variable name matters — it is
      # the one `resolve_db_config` resolves FIRST and the one the CLI's
      # port-conflict remedy appends to .env (DOCKER_DB_EXTERNAL_PORT=13306
      # when 3306 is taken). Publish under any other name and that remedy
      # becomes a silent no-op.
      - "127.0.0.1:${DOCKER_DB_EXTERNAL_PORT:-{{DB_PORT}}}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}}
    volumes:
      - db-data:/var/lib/mysql
    restart: unless-stopped
    healthcheck:
      test: "/usr/bin/mysql --user=root --password=$$MYSQL_ROOT_PASSWORD --execute \"SHOW DATABASES;\""
      interval: 5s
      timeout: 10s
      retries: 40

  ac-db-import:
    container_name: ac-db-import
    image: {{IMAGE_PREFIX}}db-import:${IMAGE_TAG:-{{IMAGE_TAG}}}
    networks: [ac-network]
    environment:
      AC_DATA_DIR: "/azerothcore/env/dist/data"
      AC_LOGS_DIR: "/azerothcore/env/dist/logs"
      AC_LOGIN_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_auth"
      AC_WORLD_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_world"
      AC_CHARACTER_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_characters"
      AC_PLAYERBOTS_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_playerbots"
    volumes:
      - ./env/dist/etc:/azerothcore/env/dist/etc
      - ./env/dist/logs:/azerothcore/env/dist/logs
    depends_on:
      ac-database:
        condition: service_healthy

  ac-client-data-init:
    container_name: ac-client-data-init
    image: {{IMAGE_PREFIX}}client-data:${IMAGE_TAG:-{{IMAGE_TAG}}}
    volumes:
      - client-data:/azerothcore/env/dist/data

  ac-authserver:
    container_name: ac-authserver
    image: {{IMAGE_PREFIX}}authserver:${IMAGE_TAG:-{{IMAGE_TAG}}}
    networks: [ac-network]
    tty: true
    restart: unless-stopped
    environment:
      AC_LOGS_DIR: "/azerothcore/env/dist/logs"
      AC_TEMP_DIR: "/azerothcore/env/dist/temp"
      AC_LOGIN_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_auth"
    volumes:
      - ./env/dist/etc:/azerothcore/env/dist/etc
      - ./env/dist/logs:/azerothcore/env/dist/logs
    ports:
      # The game client connects to this from the LAN, so it is deliberately
      # NOT loopback-pinned (unlike the DB and SOAP admin ports).
      - "${DOCKER_AUTH_EXTERNAL_PORT:-{{AUTH_PORT}}}:3724"
    depends_on:
      ac-database:
        condition: service_healthy
      ac-db-import:
        condition: service_completed_successfully

  ac-worldserver:
    container_name: ac-worldserver
    image: {{IMAGE_PREFIX}}worldserver:${IMAGE_TAG:-{{IMAGE_TAG}}}
    networks: [ac-network]
    # stdin + tty keep the worldserver CONSOLE attachable: the post-install
    # account step drives it with `docker attach`, and losing either turns
    # that into a silent hang.
    stdin_open: true
    tty: true
    restart: unless-stopped
    # Give the world time to save 1600+ bots + players on shutdown instead of
    # compose's 10s default SIGKILL.
    stop_grace_period: 5m
    environment:
      AC_DATA_DIR: "/azerothcore/env/dist/data"
      AC_LOGS_DIR: "/azerothcore/env/dist/logs"
      AC_LOGIN_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_auth"
      AC_WORLD_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_world"
      AC_CHARACTER_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_characters"
      AC_PLAYERBOTS_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_playerbots"
      # Runtime settings (SOAP, bot population, rates) live in
      # docker-compose.override.yml — the dml config system owns that file.
    ports:
      - "${DOCKER_WORLD_EXTERNAL_PORT:-{{WORLD_PORT}}}:8085"
      # SOAP is pinned to loopback by the DEFAULT VALUE, never by an IP prefix
      # on the mapping: `dml wow soap-setup` writes the WHOLE host binding into
      # .env as DOCKER_SOAP_EXTERNAL_PORT=127.0.0.1:7878, so a literal prefix
      # here would render 127.0.0.1:127.0.0.1:7878:7878. Compose also
      # CONCATENATES ports: lists across files — never add a second entry for
      # this port in the override.
      - "${DOCKER_SOAP_EXTERNAL_PORT:-127.0.0.1:{{SOAP_PORT}}}:7878"
    volumes:
      # env/dist/etc must be bound out to the host: it is where
      # `config::conf_path_in` reads and writes worldserver.conf and every
      # module conf. Without it the whole Settings/Modules surface is blind.
      - ./env/dist/etc:/azerothcore/env/dist/etc
      - ./env/dist/logs:/azerothcore/env/dist/logs
      - client-data:/azerothcore/env/dist/data/:ro
      # The ./modules source mount lives in docker-compose.override.yml.
    depends_on:
      ac-database:
        condition: service_healthy
      ac-db-import:
        condition: service_completed_successfully
      ac-client-data-init:
        condition: service_completed_successfully

networks:
  ac-network:

volumes:
  db-data:
  client-data:
