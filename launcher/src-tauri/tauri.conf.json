{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DML Launcher",
  "version": "0.1.0",
  "identifier": "com.dadsmmolab.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DML Launcher",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../cli/dml": "cli/dml",
      "../../cli/lua/party": "cli/lua/party",
      "../../cli/lua/gm": "cli/lua/gm",
      "../../guides/wow-wotlk/install-wow-wotlk.sh": "installers/install-wow-wotlk.sh",
      "../../guides/wow-vanilla/install-wow-vanilla.sh": "installers/install-wow-vanilla.sh",
      "../../guides/wow-tbc/install-wow-tbc.sh": "installers/install-wow-tbc.sh",
      "../../guides/Maplestory/install-maplestory.sh": "installers/install-maplestory.sh",
      "../../guides/runescape/install-runescape.sh": "installers/install-runescape.sh",
      "../../guides/Mu-online/install-muonline.sh": "installers/install-muonline.sh",
      "backend/dml-wow": "backend/dml-wow"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
