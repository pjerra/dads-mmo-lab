+def shot(widget, name: str) -> None:
+    """Photograph a widget, and record what the SERVER was doing at that instant.
+
+    A frame of a tab is worth nothing if the thing it is a tab for had died a minute
+    earlier -- a dead server photographs like a refusal. So every capture writes a sidecar
+    line naming the containers `docker ps` reports up at the moment of the grab, read by a
+    route that is not the widget.
+    """
+    SHOTS.mkdir(parents=True, exist_ok=True)
+    QApplication.instance().processEvents()
+    path = SHOTS / f"{name}.png"
+    widget.grab().save(str(path))
+    up = subprocess.run(["docker", "ps", "--format", "{{.Names}}"],
+                        capture_output=True, text=True).stdout.split()
+    alive = [n for n in ("ac-database", "ac-authserver", "ac-worldserver") if n in up]
+    line = (f"{time.strftime('%FT%T%z')}  {path.name}  containers alive at capture: "
+            f"{alive if alive else 'NONE'}")
+    say(f"       [shot] {line}")
+    with (SHOTS / "shots.txt").open("a", encoding="utf-8") as handle:
+        handle.write(line + "\n")
+
+
+def show_tab(view, title: str) -> bool:
+    """Bring a named tab to the front so a grab photographs it rather than whatever was up."""
+    tabs = view._tabs  # noqa: SLF001 -- a gate photographing the surface a user sees
+    for index in range(tabs.count()):
+        if tabs.tabText(index) == title:
+            tabs.setCurrentIndex(index)
+            QApplication.instance().processEvents()
+            return True
+    say(f"       [shot] no tab titled {title!r}; tabs are "
+        f"{[tabs.tabText(i) for i in range(tabs.count())]}")
+    return False
+
