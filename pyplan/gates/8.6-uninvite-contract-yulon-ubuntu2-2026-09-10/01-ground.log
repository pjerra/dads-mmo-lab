-- the deployed dml_uninvite.lua, whole (this is the OLD one-argument script) --
     1	--[[ ============================================================
     2	  dml_uninvite.lua — Dad's MMO Lab "kick a bot from my party" relay
     3	  (AGPL-3.0, part of dads-mmo-lab; reimplemented, not copied.)
     4	
     5	  Registers a console/SOAP-callable command:
     6	      dml_uninvite <botName>
     7	
     8	  Calls bot:RemoveFromGroup() (AC Player::RemoveFromGroup) directly
     9	  via Eluna — /uninvite is an opcode-layer slash command that
    10	  Player:RunCommand cannot drive, and there is no SOAP kick command.
    11	  The bot knows its own group; remaining members get the leave packet.
    12	============================================================ --]]
    13	
    14	local function OnUninviteCommand(event, player, command)
    15	    if player ~= nil then return end
    16	
    17	    local bname = command:match("^dml_uninvite%s+(%S+)$")
    18	    if not bname then return end
    19	
    20	    local b = GetPlayerByName(bname)
    21	    if not b then
    22	        print(string.format("[dml_uninvite] bot not found: %s", bname))
    23	        return false
    24	    end
    25	    b:RemoveFromGroup()
    26	    print(string.format("[dml_uninvite] removed %s from group", bname))
    27	    return false
    28	end
    29	
    30	RegisterPlayerEvent(42, OnUninviteCommand)
    31	print("[dml_uninvite] loaded -- group-remove relay ready")

